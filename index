<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Konflikt-Atlas · Geopolitisches Lagebild</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
  :root{
    --bg:#070a0f; --panel:#0f141d; --panel-2:#161d28; --panel-3:#1d2633;
    --line:#28323f; --line-2:#323e4e;
    --ink:#e8edf4; --ink-dim:#7e8b9d; --ink-faint:#566375;
    --conflict:#ff4d3d; --battle:#ff7847; --protest:#ffc83d;
    --pipeline-oil:#c77dff; --pipeline-gas:#7a5cff;
    --route:#21c7d6; --choke:#3ecf8e; --nuclear:#ffe14d;
    --port:#5b9bff; --sanction:#ff5da2; --plane:#9fb3c8;
    --font-display:"Georgia",ui-serif,serif;
    --font-body:ui-monospace,"SF Mono","Cascadia Mono","Roboto Mono",monospace;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{height:100%}
  body{background:var(--bg);color:var(--ink);font-family:var(--font-body);font-size:13px;overflow:hidden}
  #app{display:grid;grid-template-columns:320px 1fr;height:100vh}

  #sidebar{background:var(--panel);border-right:1px solid var(--line);display:flex;flex-direction:column;overflow:hidden}
  .brand{padding:16px 18px 13px;border-bottom:1px solid var(--line);position:relative;overflow:hidden}
  .brand::after{content:"";position:absolute;top:-40%;right:-10%;width:120px;height:160px;
    background:radial-gradient(circle,rgba(255,77,61,.18),transparent 70%);pointer-events:none}
  .brand h1{font-family:var(--font-display);font-weight:600;font-size:21px;line-height:1;display:flex;align-items:center;gap:8px}
  .brand h1 .live{font-family:var(--font-body);font-size:8.5px;letter-spacing:.15em;background:var(--conflict);
    color:#fff;padding:2px 6px;border-radius:4px;animation:livePulse 2s infinite}
  @keyframes livePulse{50%{opacity:.55}}
  .brand .sub{color:var(--ink-dim);font-size:10px;margin-top:6px;text-transform:uppercase;letter-spacing:.2em}
  .scroll{overflow-y:auto;flex:1;padding:12px 16px 90px}
  .scroll::-webkit-scrollbar{width:7px}.scroll::-webkit-scrollbar-thumb{background:var(--line-2);border-radius:4px}

  .section-label{font-size:9.5px;text-transform:uppercase;letter-spacing:.2em;color:var(--ink-faint);
    margin:16px 0 8px;display:flex;align-items:center;gap:8px}
  .section-label::after{content:"";flex:1;height:1px;background:var(--line)}
  .section-label:first-child{margin-top:2px}

  .layer-toggle{display:flex;align-items:center;gap:9px;padding:7px 10px;border:1px solid var(--line);
    border-radius:7px;margin-bottom:6px;cursor:pointer;background:var(--panel-2);
    transition:border-color .15s,background .15s,opacity .15s;user-select:none}
  .layer-toggle:hover{border-color:var(--line-2);background:var(--panel-3)}
  .layer-toggle.off{opacity:.4}
  .swatch{width:10px;height:10px;border-radius:3px;flex:0 0 auto;box-shadow:0 0 8px currentColor}
  .swatch.line{height:3px;width:14px;border-radius:2px}
  .layer-toggle .name{flex:1;font-size:12px}
  .layer-toggle .cnt{color:var(--ink-faint);font-size:10.5px;min-width:22px;text-align:right}

  .basemap-row{display:flex;gap:6px;margin-bottom:4px}
  .basemap-btn{flex:1;text-align:center;padding:7px 0;border:1px solid var(--line);border-radius:7px;
    background:var(--panel-2);cursor:pointer;font-size:10.5px;color:var(--ink-dim)}
  .basemap-btn.active{border-color:var(--route);color:var(--ink);background:var(--panel-3)}

  .hint{color:var(--ink-dim);font-size:10.5px;line-height:1.55;padding:9px 11px;
    border:1px dashed var(--line-2);border-radius:7px;margin-top:4px}
  .hint b{color:var(--protest)}

  #map{height:100vh;width:100%;background:#05070a;z-index:1}
  .leaflet-container{background:#05070a;font-family:var(--font-body)}
  .leaflet-popup-content-wrapper{background:var(--panel-2);color:var(--ink);border:1px solid var(--line-2);border-radius:9px}
  .leaflet-popup-tip{background:var(--panel-2);border:1px solid var(--line-2)}
  .leaflet-popup-content{margin:11px 13px;font-size:11.5px;line-height:1.5}
  .leaflet-popup-content b{font-family:var(--font-display);font-size:13.5px}
  .leaflet-popup-content .tag{display:inline-block;font-size:9px;letter-spacing:.08em;text-transform:uppercase;
    padding:2px 6px;border-radius:4px;margin-top:6px}
  .leaflet-bar a{background:var(--panel-2);color:var(--ink);border-color:var(--line-2)}
  .leaflet-bar a:hover{background:var(--panel-3)}
  .plane-icon{font-size:15px;line-height:1;filter:drop-shadow(0 0 3px rgba(159,179,200,.6))}

  #topbar{position:absolute;top:14px;left:50%;transform:translateX(-50%);z-index:1000;display:flex;gap:8px;
    align-items:center;background:rgba(15,20,29,.93);backdrop-filter:blur(10px);border:1px solid var(--line-2);
    border-radius:30px;padding:6px 8px 6px 15px;box-shadow:0 10px 36px rgba(0,0,0,.5)}
  #topbar .status{font-size:10.5px;color:var(--ink-dim);display:flex;align-items:center;gap:7px;white-space:nowrap}
  .dot{width:7px;height:7px;border-radius:50%;background:var(--choke)}
  .dot.load{background:var(--protest);animation:blink 1s infinite}.dot.err{background:var(--conflict)}
  @keyframes blink{50%{opacity:.3}}
  .tb-btn{background:var(--panel-2);border:1px solid var(--line-2);color:var(--ink);border-radius:20px;
    padding:6px 13px;cursor:pointer;font-family:inherit;font-size:10.5px}
  .tb-btn:hover{border-color:var(--route)}

  #clock{position:absolute;bottom:14px;left:14px;z-index:1000;background:rgba(15,20,29,.9);
    border:1px solid var(--line);border-radius:8px;padding:8px 12px;font-size:10.5px;color:var(--ink-dim)}
  #clock b{color:var(--ink);font-family:var(--font-display)}

  #ai{position:absolute;top:0;right:0;height:100vh;width:430px;background:var(--panel);
    border-left:1px solid var(--line-2);z-index:1200;transform:translateX(100%);
    transition:transform .28s cubic-bezier(.4,0,.2,1);display:flex;flex-direction:column;
    box-shadow:-18px 0 48px rgba(0,0,0,.55)}
  #ai.open{transform:translateX(0)}
  .ai-head{padding:15px 18px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:flex-start;gap:10px;position:relative;overflow:hidden}
  .ai-head::after{content:"";position:absolute;top:-50%;left:-10%;width:150px;height:120px;background:radial-gradient(circle,rgba(33,199,214,.14),transparent 70%)}
  .ai-head .region{font-family:var(--font-display);font-size:18px;line-height:1.2}
  .ai-head .coords{color:var(--ink-faint);font-size:10px;margin-top:4px}
  .ai-head .ctx{color:var(--route);font-size:9.5px;margin-top:5px;letter-spacing:.04em}
  .closeBtn{background:none;border:none;color:var(--ink-dim);font-size:24px;cursor:pointer;line-height:1;z-index:2}
  .closeBtn:hover{color:var(--ink)}
  .ai-body{flex:1;overflow-y:auto;padding:16px 18px}
  .ai-body::-webkit-scrollbar{width:7px}.ai-body::-webkit-scrollbar-thumb{background:var(--line-2);border-radius:4px}
  .msg{margin-bottom:15px;line-height:1.62;font-size:12.5px}
  .msg.user{color:var(--protest)}.msg.user::before{content:"› ";color:var(--ink-faint)}
  .msg.ai{white-space:pre-wrap}.msg.ai b{font-family:var(--font-display);color:#fff}
  .thinking{color:var(--ink-dim);font-style:italic}
  .empty-state{color:var(--ink-faint);font-size:11.5px;line-height:1.6;text-align:center;margin-top:30px;padding:0 10px}
  .ai-foot{padding:13px 18px;border-top:1px solid var(--line)}
  .chips{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px}
  .chip{background:var(--panel-2);border:1px solid var(--line-2);color:var(--ink-dim);border-radius:14px;
    padding:5px 11px;font-size:10px;cursor:pointer}
  .chip:hover{border-color:var(--conflict);color:var(--ink)}
  .ask-row{display:flex;gap:8px}
  #askInput{flex:1;background:var(--panel-2);border:1px solid var(--line-2);color:var(--ink);border-radius:8px;
    padding:10px 12px;font-family:inherit;font-size:12px;resize:none;max-height:120px}
  #askInput:focus{outline:none;border-color:var(--conflict)}
  #sendBtn{background:var(--conflict);border:none;color:#fff;border-radius:8px;padding:0 16px;cursor:pointer;font-size:14px}
  #sendBtn:disabled{opacity:.4;cursor:not-allowed}
  .backend-note{font-size:9.5px;color:var(--ink-faint);margin-top:8px;line-height:1.45}
</style>
</head>
<body>
<div id="app">
  <aside id="sidebar">
    <div class="brand">
      <h1>Konflikt-Atlas <span class="live">LIVE</span></h1>
      <div class="sub">Geopolitisches Lagebild</div>
    </div>
    <div class="scroll">
      <div class="section-label">Kartenansicht</div>
      <div class="basemap-row">
        <div class="basemap-btn active" data-base="dark">Dunkel</div>
        <div class="basemap-btn" data-base="sat">Satellit</div>
        <div class="basemap-btn" data-base="terrain">Relief</div>
      </div>

      <div class="section-label">Ereignisse</div>
      <div id="eventList"></div>

      <div class="section-label">Energie & Infrastruktur</div>
      <div id="energyList"></div>

      <div class="section-label">See & Handel</div>
      <div id="maritimeList"></div>

      <div class="section-label">Politik</div>
      <div id="politicsList"></div>

      <div class="section-label">Luftraum</div>
      <div id="airList"></div>

      <div class="section-label">KI-Analyse</div>
      <div class="hint">Klick auf eine beliebige Stelle der Karte. Die KI bekommt automatisch die <b>sichtbaren Ereignisse, Pipelines, Häfen & AKW</b> der Umgebung als Kontext und beantwortet deine Fragen.</div>
    </div>
  </aside>

  <div style="position:relative">
    <div id="topbar">
      <div class="status"><span class="dot" id="statusDot"></span><span id="statusText">Initialisiere…</span></div>
      <button class="tb-btn" id="refreshBtn">↻ Aktualisieren</button>
      <button class="tb-btn" id="planeBtn">✈ Flüge</button>
    </div>
    <div id="clock"><b id="utcTime">--:--</b> UTC · <span id="evtTotal">0</span> Ereignisse</div>
    <div id="map"></div>
  </div>
</div>

<div id="ai">
  <div class="ai-head">
    <div>
      <div class="region" id="aiRegion">Region wählen</div>
      <div class="coords" id="aiCoords"></div>
      <div class="ctx" id="aiCtx"></div>
    </div>
    <button class="closeBtn" id="closeAi">×</button>
  </div>
  <div class="ai-body" id="aiBody">
    <div class="empty-state" id="emptyState">Klicke auf die Karte, um eine Region zu analysieren.<br><br>Die KI erhält die lokale Lage als Kontext.</div>
  </div>
  <div class="ai-foot">
    <div class="chips" id="chips">
      <span class="chip" data-q="Fasse die aktuelle geopolitische und Sicherheitslage dieser Region zusammen.">Lage</span>
      <span class="chip" data-q="Welche Pipelines, Handelsrouten, Häfen und strategischen Chokepoints sind hier relevant und warum?">Infrastruktur</span>
      <span class="chip" data-q="Welche Staaten, Allianzen und nichtstaatlichen Akteure haben hier Interessen?">Akteure</span>
      <span class="chip" data-q="Welche Sanktionen betreffen diese Region und welche Wirkung haben sie?">Sanktionen</span>
      <span class="chip" data-q="Welche Eskalationsszenarien und Risiken sind für die kommenden Monate denkbar?">Risiken</span>
    </div>
    <div class="ask-row">
      <textarea id="askInput" rows="1" placeholder="Frage zur Region…"></textarea>
      <button id="sendBtn">→</button>
    </div>
    <div class="backend-note" id="backendNote"></div>
  </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
/* ════════════════════════════════════════════════════════════════
   KONFLIKT-ATLAS  ·  Single-File Grundgerüst (ausführliche Version)
   ────────────────────────────────────────────────────────────────
   WICHTIG ZUR ARCHITEKTUR:
   • GDELT & Anthropic-API senden KEINE CORS-Header bzw. dürfen
     nicht direkt aus dem Browser aufgerufen werden.
   • Aus einer file:// Datei funktioniert KEIN externer API-Call.
   • Diese Datei läuft daher mit umfangreichen EINGEBETTETEN Daten.
   • Für ECHTE Live-Daten: über Netlify mit Functions betreiben,
     unten USE_BACKEND = true setzen (Function-Code separat).
   ════════════════════════════════════════════════════════════════ */

const CONFIG = {
  USE_BACKEND: false,
  BACKEND_BASE: '/.netlify/functions'
};

const map = L.map('map',{zoomControl:true,worldCopyJump:true,minZoom:2}).setView([28,25],3);
const bases = {
  dark: L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png',
    {attribution:'© OSM, © CARTO',subdomains:'abcd',maxZoom:19}),
  sat: L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
    {attribution:'© Esri, Maxar, Earthstar',maxZoom:19}),
  terrain: L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png',
    {attribution:'© OSM, © CARTO',subdomains:'abcd',maxZoom:19})
};
let activeBase = bases.dark.addTo(map);
document.querySelectorAll('.basemap-btn').forEach(b=>{
  b.onclick=()=>{
    document.querySelectorAll('.basemap-btn').forEach(x=>x.classList.remove('active'));
    b.classList.add('active');
    map.removeLayer(activeBase);
    activeBase = bases[b.dataset.base].addTo(map);
    activeBase.bringToBack && activeBase.bringToBack();
  };
});

function LG(name,color,on=true,line=false){return {name,color,on,line,group:L.layerGroup()};}
const L_ = {
  conflict: LG('Bewaffnete Konflikte','#ff4d3d'),
  battle:   LG('Gefechte / Offensiven','#ff7847'),
  protest:  LG('Proteste & Unruhen','#ffc83d'),
  pipeOil:  LG('Ölpipelines','#c77dff',true,true),
