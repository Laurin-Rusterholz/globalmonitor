  routes:   LG('Handelsrouten','#21c7d6',true,true),
  choke:    LG('Chokepoints','#3ecf8e'),
  ports:    LG('Strategische Häfen','#5b9bff'),
  sanctions:LG('Sanktionierte Staaten','#ff5da2'),
  planes:   LG('Flugzeuge (Live)','#9fb3c8',false),
};
Object.values(L_).forEach(l=>{ if(l.on) l.group.addTo(map); });

function buildToggles(keys,containerId){
  const c=document.getElementById(containerId);c.innerHTML='';
  keys.forEach(key=>{
    const l=L_[key];
    const el=document.createElement('div');
    el.className='layer-toggle'+(l.on?'':' off');
    el.innerHTML=`<span class="swatch ${l.line?'line':''}" style="background:${l.color};color:${l.color}"></span>
      <span class="name">${l.name}</span><span class="cnt" id="cnt-${key}"></span>`;
    el.onclick=()=>{l.on=!l.on;el.classList.toggle('off',!l.on);
      if(l.on)map.addLayer(l.group);else map.removeLayer(l.group);};
    c.appendChild(el);
  });
}
buildToggles(['conflict','battle','protest'],'eventList');
buildToggles(['pipeOil','pipeGas','nuclear'],'energyList');
buildToggles(['routes','choke','ports'],'maritimeList');
buildToggles(['sanctions'],'politicsList');
buildToggles(['planes'],'airList');

