function setStatus(t,state){
  document.getElementById('statusText').textContent=t;
  document.getElementById('statusDot').className='dot'+(state==='load'?' load':state==='err'?' err':'');
}

let conflictStore = [];
async function loadConflicts(){
  setStatus('Lade Konfliktdaten…','load');
  ['conflict','battle','protest'].forEach(k=>L_[k].group.clearLayers());
  conflictStore=[];
  if(CONFIG.USE_BACKEND){
    try{
      const res=await fetch(`${CONFIG.BACKEND_BASE}/conflicts`);
      const data=await res.json();
      placeConflicts(data.events||[]);
      setStatus(`${conflictStore.length} Live-Ereignisse`,'ok');
    }catch(e){ console.error(e); useDemo('Backend-Fehler'); }
  } else { useDemo('Demodaten'); }
  updateTotals();
}
function placeConflicts(events){
  events.forEach(ev=>{
    const cat = ev.c || 'conflict';
    const lg = L_[cat] || L_.conflict;
    const r = ev.count ? Math.min(4+Math.log(ev.count+1)*2.2,15) : 7;
    L.circleMarker([ev.la,ev.lo],{radius:r,color:lg.color,fillColor:lg.color,fillOpacity:.35,weight:1.5})
      .bindPopup(`<b>${ev.n}</b><br>${ev.i||''}${ev.count?`<br><span style="color:#7e8b9d">${ev.count} Meldungen</span>`:''}
        <br><span class="tag" style="background:${lg.color}22;color:${lg.color}">${lg.name}</span>`)
      .addTo(lg.group);
    conflictStore.push(ev);
  });
}
function useDemo(reason){
  placeConflicts(DEMO_CONFLICTS);
  setStatus(`${conflictStore.length} Ereignisse · ${reason}`, CONFIG.USE_BACKEND?'err':'ok');
}
function updateTotals(){
  ['conflict','battle','protest'].forEach(k=>
    setCnt(k, conflictStore.filter(e=>(e.c||'conflict')===k).length));
  document.getElementById('evtTotal').textContent=conflictStore.length;
}

let planeTimer=null;
async function loadPlanes(){
  L_.planes.group.clearLayers();
  if(!CONFIG.USE_BACKEND){
    const demo=[[51,5,'DLH441'],[40,-73,'UAL88'],[25,55,'UAE12'],[35,139,'JAL6'],[1.3,103.8,'SIA22']];
    demo.forEach(d=>planeMarker(d[0],d[1],Math.random()*360,d[2]+' (Demo)'));
    setCnt('planes','demo');
    return;
  }
  try{
    const b=map.getBounds();
    const res=await fetch(`${CONFIG.BACKEND_BASE}/planes?lamin=${b.getSouth()}&lomin=${b.getWest()}&lamax=${b.getNorth()}&lomax=${b.getEast()}`);
    const data=await res.json();
    (data.states||[]).slice(0,200).forEach(s=>{
      if(s[5]&&s[6]) planeMarker(s[6],s[5],s[10]||0,(s[1]||'').trim()||s[0]);
    });
    setCnt('planes',(data.states||[]).length);
  }catch(e){console.error(e);}
}
function planeMarker(la,lo,heading,label){
  const icon=L.divIcon({className:'',html:`<div class="plane-icon" style="transform:rotate(${heading}deg)">✈</div>`,iconSize:[16,16]});
  L.marker([la,lo],{icon}).bindPopup(`<b>${label}</b><br>Flug · Kurs ${Math.round(heading)}°`).addTo(L_.planes.group);
}
document.getElementById('planeBtn').onclick=()=>{
  const t=document.querySelector('#airList .layer-toggle');
  L_.planes.on=!L_.planes.on;
  t.classList.toggle('off',!L_.planes.on);
  if(L_.planes.on){map.addLayer(L_.planes.group);loadPlanes();planeTimer=setInterval(loadPlanes,15000);}
  else{map.removeLayer(L_.planes.group);clearInterval(planeTimer);}
};
document.getElementById('refreshBtn').onclick=()=>{loadConflicts();if(L_.planes.on)loadPlanes();};

setInterval(()=>{document.getElementById('utcTime').textContent=
  new Date().toISOString().substr(11,5);},1000);

/* ════════ KI-REGIONSABFRAGE ════════ */
const aiPanel=document.getElementById('ai'),aiBody=document.getElementById('aiBody');
const askInput=document.getElementById('askInput'),sendBtn=document.getElementById('sendBtn');
let currentRegion=null, history=[];

function nearby(lat,lng,arr,getLa,getLo,getName,radiusDeg=12){
  return arr.filter(o=>Math.abs(getLa(o)-lat)<radiusDeg&&Math.abs(getLo(o)-lng)<radiusDeg).map(getName);
}
map.on('click',async e=>{
  const {lat,lng}=e.latlng;
  currentRegion={lat:lat.toFixed(2),lng:lng.toFixed(2)};
  history=[]; aiBody.innerHTML='';
  document.getElementById('emptyState')?.remove();
  document.getElementById('aiCoords').textContent=`${currentRegion.lat}°, ${currentRegion.lng}°`;
  document.getElementById('aiRegion').textContent='Ermittle Region…';
  const ctxConflicts=conflictStore.filter(c=>Math.abs(c.la-lat)<12&&Math.abs(c.lo-lng)<12).map(c=>c.n+' ('+(c.i||'')+')');
  const ctxPorts=nearby(lat,lng,PORTS,p=>p.la,p=>p.lo,p=>p.n);
  const ctxNuc=nearby(lat,lng,NUCLEAR,n=>n.la,n=>n.lo,n=>n.n);
  const ctxChoke=nearby(lat,lng,CHOKES,c=>c.la,c=>c.lo,c=>c.n);
  const ctxSanc=nearby(lat,lng,SANCTIONS,s=>s.la,s=>s.lo,s=>s.n,15);
  currentRegion.context={conflicts:ctxConflicts,ports:ctxPorts,nuclear:ctxNuc,chokes:ctxChoke,sanctions:ctxSanc};
  const parts=[];
  if(ctxConflicts.length)parts.push(`${ctxConflicts.length} Konflikt(e)`);
  if(ctxChoke.length)parts.push(`${ctxChoke.length} Chokepoint(s)`);
  if(ctxPorts.length)parts.push(`${ctxPorts.length} Hafen/Häfen`);
  if(ctxNuc.length)parts.push(`${ctxNuc.length} AKW`);
  document.getElementById('aiCtx').textContent=parts.length?('Erkannt: '+parts.join(' · ')):'';
  aiPanel.classList.add('open');
  reverseGeocode(lat,lng);
});
async function reverseGeocode(lat,lng){
  try{
    const r=await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&zoom=5&accept-language=de`);
    const d=await r.json();
    const name=d.address?.country||d.display_name||`Region ${currentRegion.lat}, ${currentRegion.lng}`;
    document.getElementById('aiRegion').textContent=name; currentRegion.name=name;
  }catch{
    document.getElementById('aiRegion').textContent=`Region ${currentRegion.lat}, ${currentRegion.lng}`;
    currentRegion.name='diese Region';
  }
}
document.getElementById('closeAi').onclick=()=>aiPanel.classList.remove('open');
document.querySelectorAll('.chip').forEach(c=>c.onclick=()=>{askInput.value=c.dataset.q;sendQuestion();});
sendBtn.onclick=sendQuestion;
askInput.addEventListener('input',()=>{askInput.style.height='auto';askInput.style.height=Math.min(askInput.scrollHeight,120)+'px';});
askInput.addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();sendQuestion();}});

function buildContextString(){
  const c=currentRegion.context||{};
  const lines=[];
  if(c.conflicts?.length)lines.push('Aktive Ereignisse in der Nähe: '+c.conflicts.join('; '));
  if(c.chokes?.length)lines.push('Strategische Chokepoints: '+c.chokes.join(', '));
  if(c.ports?.length)lines.push('Häfen: '+c.ports.join(', '));
  if(c.nuclear?.length)lines.push('Atomkraftwerke: '+c.nuclear.join(', '));
  if(c.sanctions?.length)lines.push('Sanktionierte Staaten in Reichweite: '+c.sanctions.join(', '));
  return lines.length?('\n\nLokaler Kartenkontext:\n'+lines.join('\n')):'';
}
async function sendQuestion(){
  const q=askInput.value.trim();
  if(!q||!currentRegion)return;
  askInput.value='';askInput.style.height='auto';
  sendBtn.disabled=true;
  appendMsg('user',q);
  const el=appendMsg('ai','');el.classList.add('thinking');el.textContent='Analysiere…';
  const sys=`Du bist ein erfahrener geopolitischer Analyst. Der Nutzer hat auf einer interaktiven Weltkarte die Region "${currentRegion.name}" (${currentRegion.lat}°, ${currentRegion.lng}°) ausgewählt. Beantworte Fragen zu Konflikten, Pipelines, Handelsrouten, Häfen, Chokepoints, Atomkraftwerken, Sanktionen und Machtinteressen. Sei präzise, faktenbasiert, einordnend. Nutze den mitgelieferten Kartenkontext, wenn relevant. Antworte auf Deutsch, kompakt (max ~220 Wörter), mit konkreten Namen. Nenne Unsicherheiten offen.${buildContextString()}`;
  history.push({role:'user',content:q});
  if(!CONFIG.USE_BACKEND){
    el.classList.remove('thinking');
    el.innerHTML=`<b>KI benötigt das Backend.</b>\n\nDie Anthropic-API kann aus Sicherheitsgründen nicht direkt aus dem Browser aufgerufen werden. Sobald die Netlify-Function <b>ai.js</b> eingerichtet und oben <b>USE_BACKEND = true</b> gesetzt ist, beantworte ich deine Frage hier – inklusive des erkannten Kontexts:\n\n${buildContextString()||'(kein lokaler Kontext in dieser Region)'}`;
    sendBtn.disabled=false;
    return;
  }
  try{
    const res=await fetch(`${CONFIG.BACKEND_BASE}/ai`,{
      method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({system:sys,messages:history})
    });
    const data=await res.json();
    const text=(data.content||[]).filter(b=>b.type==='text').map(b=>b.text).join('\n').trim()||'(Keine Antwort)';
    history.push({role:'assistant',content:text});
    el.classList.remove('thinking');renderAi(el,text);
  }catch(err){
    el.classList.remove('thinking');el.textContent='Fehler: '+err.message;
  }
  sendBtn.disabled=false;aiBody.scrollTop=aiBody.scrollHeight;
}
function appendMsg(role,text){const el=document.createElement('div');el.className='msg '+role;el.textContent=text;
  aiBody.appendChild(el);aiBody.scrollTop=aiBody.scrollHeight;return el;}
function renderAi(el,text){el.innerHTML=text.replace(/\*\*(.+?)\*\*/g,'<b>$1</b>');}

document.getElementById('backendNote').textContent = CONFIG.USE_BACKEND
  ? 'Backend aktiv · Live-Daten über Netlify Functions'
  : 'Demo-Modus · für Live-Daten Netlify Functions + USE_BACKEND=true';

loadConflicts();
</script>
