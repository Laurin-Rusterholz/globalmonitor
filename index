function renderInfra(){
  PIPELINES.forEach(p=>{
    const grp = p.t==='oil'?L_.pipeOil:L_.pipeGas;
    L.polyline(p.c,{color:grp.color,weight:2.5,opacity:.85,dashArray:p.t==='gas'?'7 5':null})
      .bindPopup(`<b>${p.n}</b><br><span class="tag" style="background:${grp.color}22;color:${grp.color}">${p.t==='oil'?'Ölpipeline':'Gaspipeline'}</span>`)
      .addTo(grp.group);
  });
  ROUTES.forEach(r=>L.polyline(r.c,{color:L_.routes.color,weight:1.8,opacity:.6})
    .bindPopup(`<b>${r.n}</b><br><span class="tag" style="background:#21c7d622;color:#21c7d6">Seehandelsroute</span>`).addTo(L_.routes.group));
  CHOKES.forEach(c=>L.circleMarker([c.la,c.lo],{radius:6,color:L_.choke.color,fillColor:L_.choke.color,fillOpacity:.7,weight:2})
    .bindPopup(`<b>${c.n}</b><br>${c.d}<br><span class="tag" style="background:#3ecf8e22;color:#3ecf8e">Chokepoint</span>`).addTo(L_.choke.group));
  PORTS.forEach(p=>L.circleMarker([p.la,p.lo],{radius:5,color:L_.ports.color,fillColor:L_.ports.color,fillOpacity:.7,weight:2})
    .bindPopup(`<b>${p.n}</b><br>${p.d}<br><span class="tag" style="background:#5b9bff22;color:#5b9bff">Hafen</span>`).addTo(L_.ports.group));
  NUCLEAR.forEach(n=>L.circleMarker([n.la,n.lo],{radius:6,color:L_.nuclear.color,fillColor:L_.nuclear.color,fillOpacity:.5,weight:2})
    .bindPopup(`<b>☢ ${n.n}</b><br>${n.d}<br><span class="tag" style="background:#ffe14d22;color:#ffe14d">Atomkraftwerk</span>`).addTo(L_.nuclear.group));
  SANCTIONS.forEach(s=>L.circleMarker([s.la,s.lo],{radius:8,color:L_.sanctions.color,fillColor:L_.sanctions.color,fillOpacity:.25,weight:2,dashArray:'3 3'})
    .bindPopup(`<b>${s.n}</b><br>${s.d}<br><span class="tag" style="background:#ff5da222;color:#ff5da2">Sanktioniert</span>`).addTo(L_.sanctions.group));

  setCnt('pipeOil',PIPELINES.filter(p=>p.t==='oil').length);
  setCnt('pipeGas',PIPELINES.filter(p=>p.t==='gas').length);
  setCnt('routes',ROUTES.length);setCnt('choke',CHOKES.length);
  setCnt('ports',PORTS.length);setCnt('nuclear',NUCLEAR.length);setCnt('sanctions',SANCTIONS.length);
}
function setCnt(k,v){const el=document.getElementById('cnt-'+k);if(el)el.textContent=v;}
